---
import ListaEventos from '../components/ListaEventos';
import RegistroPasaporteForm from '../components/RegistroPasaporteForm';
import '../styles/global.css';
---
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Eventos Sostenibles | EcoLoop Arequipa</title>
  </head>
  <body class="font-sans antialiased overflow-x-hidden selection:bg-[#7A1F3D] selection:text-white relative">
    
    <!-- Imagen de Fondo Principal Continua -->
    <div class="fixed inset-0 z-[-20] bg-[url('/hero.png')] bg-cover bg-center"></div>
    <div class="fixed inset-0 z-[-19] bg-gradient-to-b from-[#101114]/30 via-[#101114]/70 to-[#101114]"></div>

    <!-- 1. Navbar -->
    <nav class="fixed top-0 w-full z-50 bg-black/20 backdrop-blur-md border-b border-white/10 transition-all duration-300">
      <div class="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between">
        <a href="/" class="flex items-center gap-3 cursor-pointer">
          <div class="w-8 h-8 rounded-full bg-white/10 flex items-center justify-center border border-white/20">
            <span class="font-bold text-[#7A1F3D] text-xs">ECO</span>
          </div>
          <span class="font-bold tracking-widest text-lg text-white">LOOP</span>
        </a>
        <div class="hidden lg:flex items-center space-x-6 text-sm font-medium text-white/80">
          <a href="/" class="hover:text-white transition-colors">Inicio</a>
          <a href="/#que-es" class="hover:text-white transition-colors">¿Qué es EcoLoop?</a>
          <a href="/turista" class="text-[#92284B] font-bold">Eventos</a>
          <a href="/#impacto" class="hover:text-white transition-colors">Impacto</a>
        </div>
        <div class="flex items-center gap-4">
          <a href="/turista#auth" class="hidden md:block text-white hover:text-[#92284B] font-bold text-sm transition-colors">
            Inicia tus Puntos
          </a>
          <a href="/empresa" class="hidden md:block bg-[#7A1F3D] hover:bg-[#92284B] text-white px-5 py-2 rounded-full text-sm font-bold shadow-lg transition-all">
            Unirse a la Red
          </a>
          <span class="text-white/80 text-sm font-semibold cursor-pointer hover:text-white">ES ▾</span>
        </div>
      </div>
    </nav>

    <!-- Main Content -->
    <main class="relative z-10 pt-32 pb-20 w-full min-h-screen flex flex-col">
      <section class="max-w-7xl mx-auto px-6 mb-16 text-center">
        <h1 class="text-4xl md:text-6xl font-extrabold mb-4 text-white drop-shadow-md">
          Eventos de <br/>
          <span class="text-[#92284B]">Impacto Circular</span>
        </h1>
        <p class="text-white/80 max-w-xl mx-auto text-sm md:text-base font-light">
          Descubre las próximas actividades en Arequipa. Participa, aprende y conéctate con la red sostenible.
        </p>
      </section>
      
      <!-- Directorio de Eventos -->
      <section class="max-w-7xl mx-auto px-6 mb-24 w-full flex-grow">
        <ListaEventos client:load />
      </section>

      <!-- Divisor -->
      <div class="max-w-7xl mx-auto px-6 w-full">
        <div class="h-px w-full bg-gradient-to-r from-transparent via-white/20 to-transparent mb-20"></div>
      </div>

      <!-- Formulario Pasaporte (client:load para interactividad React) -->
      <section class="w-full">
        <RegistroPasaporteForm client:load />
      </section>
    </main>

    <!-- Footer -->
    <footer class="bg-transparent relative z-10 border-t border-white/5">
      <div class="max-w-7xl mx-auto px-6 py-12 grid grid-cols-1 md:grid-cols-4 gap-8">
        <div class="col-span-1">
          <div class="flex items-center gap-2 mb-3">
            <div class="w-6 h-6 rounded-full bg-[#7A1F3D] flex items-center justify-center">
              <span class="font-bold text-white text-[8px]">ECO</span>
            </div>
            <span class="font-bold tracking-widest text-sm text-white">LOOP</span>
          </div>
          <p class="text-[10px] text-white/50 leading-relaxed">Conectamos recursos,<br/>transformamos Arequipa.</p>
        </div>
        <div>
          <h4 class="text-white font-bold mb-3 text-xs">Síguenos</h4>
          <div class="flex gap-2">
            <div class="w-6 h-6 rounded-full bg-white/10 flex items-center justify-center text-white/70 hover:bg-[#7A1F3D] hover:text-white cursor-pointer transition-colors text-[10px]">IG</div>
            <div class="w-6 h-6 rounded-full bg-white/10 flex items-center justify-center text-white/70 hover:bg-[#7A1F3D] hover:text-white cursor-pointer transition-colors text-[10px]">FB</div>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>

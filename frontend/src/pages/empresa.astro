---
import DashboardImpacto from '../components/DashboardImpacto';
import GestorMermaForm from '../components/GestorMermaForm';
import '../styles/global.css';
---
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Panel Empresa | EcoLoop Arequipa</title>
  </head>
  <body class="font-sans antialiased overflow-x-hidden selection:bg-[#7A1F3D] selection:text-white relative">
    
    <!-- Imagen de Fondo Principal Continua -->
    <div class="fixed inset-0 z-[-20] bg-[url('/hero.png')] bg-cover bg-center"></div>
    <div class="fixed inset-0 z-[-19] bg-gradient-to-b from-[#101114]/30 via-[#101114]/70 to-[#101114]"></div>

    <!-- 1. Navbar -->
    <nav class="fixed top-0 w-full z-50 bg-black/20 backdrop-blur-md border-b border-white/10 transition-all duration-300">
      <div class="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between">
        <a href="/" class="flex items-center gap-3 cursor-pointer">
          <div class="w-8 h-8 rounded-full bg-white/10 flex items-center justify-center border border-white/20">
            <span class="font-bold text-[#7A1F3D] text-xs">ECO</span>
          </div>
          <span class="font-bold tracking-widest text-lg text-white">LOOP</span>
        </a>
        <div class="hidden lg:flex items-center space-x-6 text-sm font-medium text-white/80">
          <a href="/" class="hover:text-white transition-colors">Inicio</a>
          <a href="/#que-es" class="hover:text-white transition-colors">¿Qué es EcoLoop?</a>
          <a href="/turista" class="hover:text-white transition-colors">Lugares</a>
          <a href="/empresa" class="text-[#92284B] font-bold">Mi Panel</a>
        </div>
        <div class="flex items-center gap-4">
          <a href="/turista#auth" id="nav-login-btn" class="hidden md:block text-white hover:text-[#92284B] font-bold text-sm transition-colors">
            Inicia tus Puntos
          </a>
          <a href="/empresa" class="hidden md:block bg-[#7A1F3D] hover:bg-[#92284B] text-white px-5 py-2 rounded-full text-sm font-bold shadow-lg transition-all">
            Unirse a la Red
          </a>
          <span class="text-white/80 text-sm font-semibold cursor-pointer hover:text-white">ES ▾</span>
        </div>
      </div>
    </nav>

    <!-- Main Content -->
    <main class="relative z-10 pt-32 pb-20 w-full min-h-screen flex flex-col max-w-7xl mx-auto px-6">
      <section class="text-center mb-16">
        <h1 class="text-4xl md:text-5xl font-extrabold mb-4 text-white drop-shadow-md">
          Panel de <span class="text-[#92284B]">Control B2B</span>
        </h1>
        <p class="text-white/80 text-sm md:text-base font-light">
          Gestiona tus recursos, mide tu impacto ambiental en tiempo real y declara tus mermas para colaborar con la red local.
        </p>
      </section>
      
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 flex-grow mb-16">
         <!-- Metricas -->
         <div>
           <h3 class="text-xl font-bold text-white mb-6 flex items-center gap-2"><span class="text-white/60">📊</span> Métricas de Impacto</h3>
           <DashboardImpacto client:load />
         </div>
         
         <!-- Formulario -->
         <div>
           <h3 class="text-xl font-bold text-white mb-6 flex items-center gap-2"><span class="text-white/60">♻️</span> Declarar Recurso / Merma</h3>
           <div class="glass-bubble p-8">
             <GestorMermaForm client:load />
           </div>
         </div>
      </div>
    </main>

    <!-- Footer -->
    <footer class="bg-transparent relative z-10 border-t border-white/5">
      <div class="max-w-7xl mx-auto px-6 py-8">
        <p class="text-center text-[10px] text-white/30">© 2026 EcoLoop Arequipa. Todos los derechos reservados.</p>
      </div>
    </footer>

    <script>
      const updateNav = () => {
        const loginBtn = document.getElementById('nav-login-btn');
        if (loginBtn) {
          if (localStorage.getItem('loggedUser')) {
            loginBtn.textContent = 'Cerrar Sesión';
            loginBtn.href = '#';
            loginBtn.onclick = (e) => {
              e.preventDefault();
              localStorage.removeItem('loggedUser');
              window.location.reload();
            };
          } else {
            loginBtn.textContent = 'Inicia tus Puntos';
            loginBtn.href = '/turista#auth';
            loginBtn.onclick = null;
          }
        }
      };
      updateNav();
      setInterval(updateNav, 1000);
    </script>
  </body>
</html>

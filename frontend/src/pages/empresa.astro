---
// frontend/src/pages/empresa.astro
import '../styles/global.css';
import DashboardImpacto from '../components/DashboardImpacto';
import GestorMermaForm from '../components/GestorMermaForm';
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>B2B Panel - EcoLoop Arequipa</title>
    <style>
      body {
        background: radial-gradient(circle at top, #0f172a 0%, #020617 50%, #000000 100%);
        color: #f8fafc;
        min-height: 100vh;
      }
      .glass-panel {
        background: rgba(255, 255, 255, 0.03);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid rgba(255, 255, 255, 0.05);
      }
      .glass-header {
        background: rgba(2, 6, 23, 0.8);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border-bottom: 1px solid rgba(212, 175, 55, 0.2);
      }
      .glow-gold { box-shadow: 0 0 25px rgba(212, 175, 55, 0.5); }
      .gradient-text-gold {
        background: linear-gradient(to right, #F9D423, #D4AF37, #C5A028);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
      }
    </style>
  </head>
  <body class="font-sans antialiased overflow-x-hidden selection:bg-[#D4AF37] selection:text-[#020617] relative">
    
    <!-- Dynamic Background Elements -->
    <div class="fixed top-[-10%] left-[-10%] w-[50%] h-[50%] rounded-full bg-indigo-900 mix-blend-screen filter blur-[150px] opacity-30 -z-10 animate-pulse"></div>
    <div class="fixed bottom-[-10%] right-[-10%] w-[40%] h-[40%] rounded-full bg-[#D4AF37] mix-blend-screen filter blur-[150px] opacity-10 -z-10"></div>
    
    <!-- Navbar (Sticky, Dynamic) -->
    <nav class="glass-header sticky top-0 z-50 transition-all duration-300">
      <div class="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between">
        <div class="flex items-center gap-3 group cursor-pointer">
          <div class="w-10 h-10 rounded-full border border-[#D4AF37]/50 flex items-center justify-center group-hover:glow-gold transition-all duration-500">
            <span class="font-bold text-[#D4AF37] text-sm">ECO</span>
          </div>
          <span class="font-bold tracking-widest text-lg text-slate-200 group-hover:text-white transition-colors">LOOP <span class="text-[#D4AF37]">B2B</span></span>
        </div>
        <div class="hidden md:flex items-center space-x-6">
          <a href="#" class="text-slate-300 hover:text-white hover:bg-white/10 px-4 py-2 rounded-full text-sm font-semibold tracking-wide transition-all duration-300">Overview</a>
          <a href="#" class="text-slate-300 hover:text-white hover:bg-white/10 px-4 py-2 rounded-full text-sm font-semibold tracking-wide transition-all duration-300">Analytics</a>
          <a href="/turista" class="ml-4 bg-[#D4AF37] text-[#020617] px-6 py-2 rounded-full text-sm font-bold hover:shadow-[0_0_15px_rgba(212,175,55,0.6)] hover:bg-white transition-all duration-500">
            Vista Turista
          </a>
        </div>
      </div>
    </nav>

    <!-- Hero Dashboard Style -->
    <section class="pt-16 pb-8 px-6 relative z-10">
      <div class="max-w-7xl mx-auto">
        <div class="mb-10 text-center md:text-left">
          <h1 class="text-4xl md:text-5xl font-extrabold mb-4 tracking-tight">
            Bienvenido al <span class="gradient-text-gold">Command Center</span>
          </h1>
          <p class="text-lg text-slate-400 max-w-2xl font-light">
            Gestiona la economía circular de tu establecimiento. Monitorea métricas en tiempo real, optimiza la reubicación de mermas y eleva tu EcoScore.
          </p>
        </div>

        <!-- KPI Cards -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
          
          <div class="glass-panel rounded-3xl p-8 relative overflow-hidden group hover:border-[#D4AF37]/50 transition-colors cursor-default">
            <div class="absolute right-0 top-0 w-32 h-32 bg-[#D4AF37] rounded-full blur-[60px] opacity-10 group-hover:opacity-20 transition-opacity"></div>
            <h3 class="text-[10px] font-mono text-slate-400 uppercase tracking-[0.2em] mb-4">EcoScore Actual</h3>
            <div class="flex items-end gap-3 relative z-10">
              <span class="text-5xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-slate-100 to-slate-400 group-hover:from-white group-hover:to-[#D4AF37] transition-all">87</span>
              <span class="text-[#D4AF37] font-bold text-sm pb-1 tracking-wide">+12% MES</span>
            </div>
          </div>
          
          <div class="glass-panel rounded-3xl p-8 relative overflow-hidden group hover:border-[#D4AF37]/50 transition-colors cursor-default">
            <div class="absolute right-0 top-0 w-32 h-32 bg-emerald-500 rounded-full blur-[60px] opacity-10 group-hover:opacity-20 transition-opacity"></div>
            <h3 class="text-[10px] font-mono text-slate-400 uppercase tracking-[0.2em] mb-4">Mermas Revalorizadas</h3>
            <div class="flex items-end gap-3 relative z-10">
              <span class="text-5xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-slate-100 to-slate-400 group-hover:from-white group-hover:to-emerald-400 transition-all">1.2<span class="text-3xl">t</span></span>
              <span class="text-emerald-400 font-bold text-sm pb-1 tracking-wide">300kg ORG.</span>
            </div>
          </div>

          <div class="glass-panel rounded-3xl p-8 relative overflow-hidden group hover:border-[#D4AF37]/50 transition-colors cursor-default">
            <div class="absolute right-0 top-0 w-32 h-32 bg-blue-500 rounded-full blur-[60px] opacity-10 group-hover:opacity-20 transition-opacity"></div>
            <h3 class="text-[10px] font-mono text-slate-400 uppercase tracking-[0.2em] mb-4">Impacto CO2 Evitado</h3>
            <div class="flex items-end gap-3 relative z-10">
              <span class="text-5xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-slate-100 to-slate-400 group-hover:from-white group-hover:to-blue-400 transition-all">450<span class="text-3xl">kg</span></span>
              <span class="text-[#D4AF37] font-bold text-sm pb-1 tracking-wide">20 ÁRBOLES</span>
            </div>
          </div>
          
        </div>
      </div>
    </section>

    <!-- Controles Principales (React Components) -->
    <section class="py-8 px-6 relative z-10">
      <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-8">
        
        <!-- Panel Izquierdo: Gráficos -->
        <div class="glass-panel rounded-3xl p-2 border border-white/5 group hover:border-[#D4AF37]/30 transition-colors">
          <div class="p-6 border-b border-white/5 flex justify-between items-center bg-[#020617]/50 rounded-t-2xl">
            <h2 class="text-xl font-bold text-white flex items-center gap-3">
              <span class="w-2 h-2 rounded-full bg-[#D4AF37] animate-pulse glow-gold"></span>
              Monitoreo de Impacto
            </h2>
          </div>
          <div class="p-6 bg-[#0f172a]/30 rounded-b-2xl h-full flex flex-col justify-center">
            <DashboardImpacto client:load />
          </div>
        </div>

        <!-- Panel Derecho: Formulario -->
        <div class="glass-panel rounded-3xl p-2 border border-white/5 group hover:border-[#D4AF37]/30 transition-colors">
           <div class="p-6 border-b border-white/5 bg-[#020617]/50 rounded-t-2xl flex items-center gap-3">
             <div class="w-8 h-8 rounded-full bg-[#D4AF37]/10 flex items-center justify-center text-[#D4AF37]">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
             </div>
            <h2 class="text-xl font-bold text-white">
              Gestor de Recursos (Mermas)
            </h2>
          </div>
          <div class="p-6 bg-[#0f172a]/30 rounded-b-2xl">
             <GestorMermaForm client:load />
          </div>
        </div>

      </div>
    </section>

    <footer class="mt-20 py-8 text-center border-t border-white/5 bg-[#020617]/50 backdrop-blur-md">
      <p class="text-[10px] font-mono text-slate-500 tracking-[0.2em]">© 2026 ECOLOOP AREQUIPA B2B PORTAL.</p>
    </footer>
  </body>
</html>

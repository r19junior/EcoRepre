---
import CreadorItinerario from '../components/CreadorItinerario';
import '../styles/global.css';
---
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- SEO & Metadatos -->
    <meta name="description" content="Planifica tu ruta turística en Arequipa con KAYPI. Crea itinerarios personalizados optimizados con inteligencia artificial." />
    <meta name="keywords" content="Ruta Arequipa, Itinerario Arequipa, Viaje Inteligente, Planificador de Viajes, KAYPI, Arequipa AI" />
    <meta name="author" content="KAYPI Arequipa" />
    
    <!-- Open Graph -->
    <meta property="og:title" content="Planifica tu Ruta | KAYPI" />
    <meta property="og:description" content="Crea tu itinerario ideal en Arequipa con KAYPI y descubre lugares increíbles." />
    <meta property="og:image" content="/kaypi_favicon_1785822463981.png" />
    <meta property="og:type" content="website" />
    
    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Planifica tu Ruta | KAYPI" />
    <meta name="twitter:description" content="Genera rutas personalizadas y ecológicas en Arequipa." />
    <meta name="twitter:image" content="/kaypi_favicon_1785822463981.png" />
    <title>Planifica tu Ruta | KAYPI</title>
    <link rel="icon" type="image/png" href="/kaypi_favicon_1785822463981.png" />
    <link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  </head>
  <body class="font-['Quicksand',_sans-serif] antialiased overflow-x-hidden selection:bg-[#7A1E2D] selection:text-white relative">
    
    <!-- Imagen de Fondo Principal Continua -->
    <div class="fixed inset-0 z-[-20] bg-[url('/hero.png')] bg-cover bg-center"></div>
    <div class="fixed inset-0 z-[-19] bg-gradient-to-b from-[#101114]/30 via-[#101114]/70 to-[#101114]"></div>

    <!-- 1. Navbar Unificado KAYPI -->
    <nav class="fixed top-0 w-full z-50 bg-black/20 backdrop-blur-md border-b border-white/10 transition-all duration-300">
      <div class="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between">
        <a href="/" class="flex items-center gap-3 cursor-pointer">
          <img src="/kaypi_logo_1785822457628.png" alt="KAYPI Logo" class="h-10 w-auto rounded-lg" />
          <span class="font-extrabold tracking-widest text-xl text-white">KAYPI</span>
        </a>
        <div class="hidden lg:flex items-center space-x-6 text-sm font-medium text-white/80">
          <a href="/eventos" class="hover:text-white transition-colors">Eventos</a>
          <a href="/turista" class="hover:text-white transition-colors">Lugares y Servicios</a>
          <a href="/ruta" class="text-[#F1B400] font-bold">Planifica tu ruta</a>
          <a href="/rescate" class="text-emerald-400 font-bold hover:text-emerald-300 transition-colors flex items-center gap-1">
            Rescate de Comida
          </a>
        </div>
        <div class="flex items-center gap-4">
          <div class="relative group cursor-pointer py-2">
            <div class="hidden md:flex items-center gap-2 bg-white/10 px-4 py-2 rounded-full border border-white/20 group-hover:bg-white/20 transition-all">
              <span class="text-white text-xs">Hola, <b>Turista Explorador</b></span>
              <div class="w-6 h-6 rounded-full bg-[#7A1F3D] flex items-center justify-center text-[10px]">T</div>
            </div>
            <!-- Menú Desplegable del Turista -->
            <div class="absolute top-full mt-2 right-0 bg-[#101114]/95 backdrop-blur-md border border-white/10 rounded-xl p-3 flex flex-col min-w-[220px] opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all shadow-2xl z-50 transform origin-top-right scale-95 group-hover:scale-100">
              <div class="border-b border-white/10 pb-2 mb-2 px-2">
                <p class="text-[10px] text-white/50 uppercase tracking-wider font-bold">Estado de Cuenta</p>
              </div>
              <a href="/eventos" class="flex items-center justify-between text-white hover:bg-white/10 px-3 py-2 rounded-lg text-sm transition-colors">
                <span>🌟 Mis Puntos</span>
                <span class="text-[#F1B400] font-bold">150 pts</span>
              </a>
              <a href="#" class="flex items-center justify-between text-white hover:bg-white/10 px-3 py-2 rounded-lg text-sm transition-colors">
                <span>🎁 Descuentos</span>
                <span class="bg-white/20 text-[10px] px-2 py-0.5 rounded-full">2 disponibles</span>
              </a>
              <a href="#" class="flex flex-col text-white hover:bg-[#7A1F3D]/20 px-3 py-2 rounded-lg text-sm transition-colors mt-2 border border-[#7A1F3D]/30">
                <span class="font-bold text-[#F1B400] flex items-center gap-2">🎟️ Gran Sorteo 2027</span>
                <span class="text-[10px] text-white/70 leading-tight mt-1">Suma 500 pts y participa por un viaje doble a Arequipa todo pagado.</span>
              </a>
            </div>
          </div>
          <span class="text-white/80 text-sm font-semibold cursor-pointer hover:text-white">ES ▾</span>
        </div>
      </div>
    </nav>

    <!-- Main Content -->
    <main class="relative z-10 pt-32 pb-20 w-full min-h-screen flex flex-col text-center">
      
      <section class="max-w-7xl mx-auto px-6 mb-12 w-full flex-grow">
        <CreadorItinerario client:load />
      </section>

    </main>
  </body>
</html>

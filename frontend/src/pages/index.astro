        "Atractivos Turísticos": [
          { nombre: "Monasterio Santa Catalina", img: "/mod_atractivo.png", rating: "4.9 (1200 reseñas)" },
          { nombre: "Mirador de Yanahuara", img: "/mod_atractivo.png", rating: "4.8 (850 reseñas)" },
          { nombre: "Canteras de Sillar Añashuayco", img: "/mod_atractivo.png", rating: "4.8 (900 reseñas)" }
        ],
        "Guías Turísticos": [
          { nombre: "Arequipa Explorer Tours", img: "/mod_guia_1785800500716.png", rating: "4.9 (150 reseñas)" },
          { nombre: "Colca Trekking Oficial", img: "/mod_guia_1785800500716.png", rating: "4.8 (110 reseñas)" },
          { nombre: null } // Fallback handled in code if less than 3
        ],
        "Actividades": [
          { nombre: "Rafting en Río Chili", img: "/mod_actividad.png", rating: "4.9 (320 reseñas)" },
          { nombre: "Taller de Cocina Arequipeña", img: "/mod_actividad.png", rating: "4.8 (150 reseñas)" },
          { nombre: "Tour Fotográfico del Centro", img: "/mod_actividad.png", rating: "4.7 (100 reseñas)" }
        ]
      };

      const btnCategorias = document.querySelectorAll('.btn-categoria');
      btnCategorias.forEach(btn => {
        btn.addEventListener('click', (e) => {
          const categoria = e.currentTarget.getAttribute('data-categoria');
          const lugares = dataLugares[categoria] || dataLugares["Actividades"];
          
          let htmlLugares = '';
          lugares.forEach((lugar, index) => {
            if(!lugar.nombre) return;
            const esPrimero = index === 0;
            htmlLugares += `
              <div class="flex items-center gap-4 bg-white/5 p-3 rounded-xl border ${esPrimero ? 'border-[#F1B400]/50' : 'border-white/10'} hover:bg-white/10 transition-colors">
                <div class="w-8 h-8 rounded-full ${esPrimero ? 'bg-[#F1B400] text-black shadow-[0_0_15px_rgba(241,180,0,0.5)]' : 'bg-white/20 text-white'} font-bold flex items-center justify-center shrink-0">${index + 1}</div>
                <img src="${lugar.img}" class="w-12 h-12 rounded-lg object-cover border border-white/20" alt="Lugar">
                <div class="flex-1">
                  <h4 class="text-white font-bold text-sm">${lugar.nombre}</h4>
                  <p class="text-white/50 text-[10px]">⭐ ${lugar.rating} ${esPrimero ? '• 🏆 Sello KAYPI' : ''}</p>
                </div>
              </div>
            `;
          });

          Swal.fire({
            title: `Top Rankings: ${categoria}`,

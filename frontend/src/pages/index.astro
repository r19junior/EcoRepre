---
// frontend/src/pages/index.astro
import '../styles/global.css';
---
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- SEO & Metadatos -->
    <meta name="description" content="KAYPI: La plataforma web que reúne todo Arequipa en un solo lugar. Encuentra hospedajes, restaurantes, atractivos turísticos y guías oficiales con un enfoque sostenible y de economía circular." />
    <meta name="keywords" content="Arequipa, Turismo Arequipa, KAYPI, Hoteles Arequipa, Restaurantes Arequipa, Turismo Sostenible, Economía Circular, Viaje Arequipa, Guías Turísticos Arequipa" />
    <meta name="author" content="KAYPI Arequipa" />
    
    <!-- Open Graph (Facebook/LinkedIn) -->
    <meta property="og:title" content="KAYPI | Todo Arequipa, aquí." />
    <meta property="og:description" content="Planifica tu viaje de forma rápida, organizada y confiable, descubriendo experiencias y negocios locales." />
    <meta property="og:image" content="/kaypi_favicon_1785822463981.png" />
    <meta property="og:url" content="https://kaypi-arequipa.com" />
    <meta property="og:type" content="website" />
    
    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="KAYPI | Todo Arequipa, aquí." />
    <meta name="twitter:description" content="La infraestructura digital integrada del ecosistema turístico de Arequipa." />
    <meta name="twitter:image" content="/kaypi_favicon_1785822463981.png" />
    <title>KAYPI | Todo Arequipa, aquí.</title>
    <link rel="icon" type="image/png" href="/kaypi_favicon_1785822463981.png" />
    <link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  </head>
  <body class="font-['Quicksand',_sans-serif] antialiased overflow-x-hidden selection:bg-[#7A1E2D] selection:text-white relative">
    
    <!-- Imagen de Fondo Principal Continua -->
    <div class="fixed inset-0 z-[-20] bg-[url('/hero.png')] bg-cover bg-center"></div>
    <div class="fixed inset-0 z-[-19] bg-gradient-to-b from-[#101114]/30 via-[#101114]/70 to-[#101114]"></div>

    <!-- 1. Navbar -->
    <nav class="fixed top-0 w-full z-50 bg-black/20 backdrop-blur-md border-b border-white/10 transition-all duration-300">
      <div class="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between">
        <a href="/" class="flex items-center gap-3 cursor-pointer">
          <img src="/kaypi_logo_1785822457628.png" alt="KAYPI Logo" class="h-10 w-auto rounded-lg" />
          <span class="font-extrabold tracking-widest text-xl text-white">KAYPI</span>
        </a>
        <div class="hidden lg:flex items-center space-x-6 text-sm font-medium text-white/80">
          <a href="#" class="text-[#92284B] font-bold">Inicio</a>
          <a href="#que-es" class="hover:text-white transition-colors">¿Qué es KAYPI?</a>
          <a href="#modulos" class="hover:text-white transition-colors">Módulos</a>
          <a href="#impacto" class="hover:text-white transition-colors">Impacto</a>
          <a href="/turista" class="hover:text-white transition-colors">Lugares</a>
          <a href="#contacto" class="hover:text-white transition-colors">Contacto</a>
        </div>
        <div class="flex items-center gap-4">
          <button id="btn-anexar-empresa" class="bg-white/10 hover:bg-white/20 text-white px-3 py-1.5 md:px-5 md:py-2 rounded-full text-xs md:text-sm font-bold border border-white/20 transition-all">
            Unirse a KAYPI
          </button>
          <button id="btn-iniciar-sesion" class="bg-[#7A1F3D] hover:bg-[#92284B] text-white px-3 py-1.5 md:px-5 md:py-2 rounded-full text-xs md:text-sm font-bold shadow-lg transition-all">
            Iniciar Sesión
          </button>
          <div class="relative group cursor-pointer py-2">
            <span class="text-white/80 text-sm font-semibold group-hover:text-white transition-colors">ES ▾</span>
            <!-- Dropdown de idiomas -->
            <div class="absolute top-full mt-2 right-0 bg-[#101114]/95 backdrop-blur-md border border-white/10 rounded-xl p-2 flex flex-col min-w-[120px] opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all shadow-2xl z-50 transform origin-top-right scale-95 group-hover:scale-100">
              <a href="#" class="text-white/70 hover:text-white hover:bg-white/10 px-3 py-2 rounded-lg text-sm transition-colors flex items-center justify-between">
                Español <span class="text-[#F1B400]">✓</span>
              </a>
              <a href="#" class="text-white/70 hover:text-white hover:bg-white/10 px-3 py-2 rounded-lg text-sm transition-colors">
                English
              </a>
              <a href="#" class="text-white/70 hover:text-white hover:bg-white/10 px-3 py-2 rounded-lg text-sm transition-colors">
                Français
              </a>
            </div>
          </div>
        </div>
      </div>
    </nav>

    <main class="relative z-10 w-full pb-20">
      
      <!-- CONTENEDOR DE PORTADA (100vh en PC) -->
      <div class="lg:min-h-[100vh] flex flex-col lg:justify-center pt-32 lg:pt-24 pb-12">
        <!-- 2. Hero + Impact Panel -->
        <section class="max-w-7xl mx-auto px-6 mb-12 lg:mb-16 flex flex-col lg:flex-row items-center gap-12 w-full">
        <!-- Hero Text -->
        <div class="flex-1 text-center lg:text-left">
          <h1 class="text-6xl md:text-8xl font-extrabold mb-2 tracking-tighter leading-none text-white drop-shadow-lg uppercase">
            KAYPI
          </h1>
          <h2 class="text-3xl md:text-5xl font-bold mb-6 tracking-tight text-[#F1B400] drop-shadow-sm">
            Todo Arequipa, <span class="text-[#7A1E2D]">aquí.</span>
          </h2>
          <p class="text-sm md:text-base text-white/80 mb-8 max-w-xl font-light leading-relaxed mx-auto lg:mx-0">
            Para los turistas que visitan Arequipa, nuestra propuesta es una plataforma web que reúne en un solo lugar hospedajes, restaurantes, atractivos, guías y actividades, porque les permite planificar su viaje de forma más rápida, organizada y confiable, mientras descubren más experiencias y negocios locales.
          </p>
          <div class="flex flex-col sm:flex-row items-center gap-5 justify-center lg:justify-start mt-4">
            <a href="/eventos" class="bg-[#7A1F3D] text-white px-8 py-4 rounded-full font-bold shadow-[0_10px_30px_rgba(122,31,61,0.3)] hover:bg-[#92284B] transition-all flex items-center gap-2 text-base md:text-lg">
              Gana Puntos →
            </a>
            <a href="/turista" class="glass-bubble text-white px-8 py-4 rounded-full font-bold hover:bg-white/10 transition-all border border-white/20 text-base md:text-lg">
              Crear mi itinerario
            </a>
          </div>
        </div>
        
        <!-- Impact Panel -->
        <div class="w-full lg:w-[420px] glass-bubble p-6 border border-white/20 relative overflow-hidden shadow-2xl">
          <div class="absolute inset-0 bg-gradient-to-br from-[#7A1E2D]/20 to-[#101114] pointer-events-none"></div>
          
          <h3 class="text-white font-bold text-sm mb-5 relative z-10 flex items-center justify-between">
            <span>Impacto en la Red Local</span>
            <span class="text-[9px] font-bold bg-[#4F8A5B]/20 text-[#4F8A5B] border border-[#4F8A5B]/50 px-2 py-1 rounded-full flex items-center gap-1">
              <span class="w-1.5 h-1.5 rounded-full bg-[#4F8A5B] animate-pulse"></span> +12% hoy
            </span>
          </h3>
          
          <div class="grid grid-cols-2 gap-4 relative z-10">
            <!-- Box 1: Empresas -->
            <div class="bg-black/60 border border-white/10 rounded-2xl p-4 relative overflow-hidden group hover:border-[#7A1F3D]/50 transition-colors cursor-default">
              <img src="/mod_hotel_1785800485064.png" class="absolute inset-0 w-full h-full object-cover opacity-20 group-hover:opacity-40 transition-opacity duration-500" />
              <div class="absolute inset-0 bg-gradient-to-t from-black/80 to-transparent"></div>
              <div class="relative z-10">
                <div class="text-2xl font-bold text-white">124</div>
                <div class="text-[10px] text-white/70 mt-0.5">Empresas en red</div>
                <div class="text-[9px] text-[#4F8A5B] mt-1.5 font-bold">↑ 8 nuevos afiliados</div>
              </div>
            </div>
            
            <!-- Box 2: Material -->
            <div class="bg-black/60 border border-white/10 rounded-2xl p-4 relative overflow-hidden group hover:border-[#7A1F3D]/50 transition-colors cursor-default">
              <img src="/mod_restaurante_1785800492796.png" class="absolute inset-0 w-full h-full object-cover opacity-20 group-hover:opacity-40 transition-opacity duration-500" />
              <div class="absolute inset-0 bg-gradient-to-t from-black/80 to-transparent"></div>
              <div class="relative z-10">
                <div class="text-2xl font-bold text-white">2.5 <span class="text-xs font-normal text-white/60">ton</span></div>
                <div class="text-[10px] text-white/70 mt-0.5">Material recuperado</div>
                <div class="text-[9px] text-[#4F8A5B] mt-1.5 font-bold">↑ 15% mensual</div>
              </div>
            </div>
            
            <!-- Box 3: Emisiones -->
            <div class="bg-black/60 border border-white/10 rounded-2xl p-4 relative overflow-hidden group hover:border-[#7A1F3D]/50 transition-colors cursor-default">
              <img src="/mod_guia_1785800500716.png" class="absolute inset-0 w-full h-full object-cover opacity-20 group-hover:opacity-40 transition-opacity duration-500" />
              <div class="absolute inset-0 bg-gradient-to-t from-black/80 to-transparent"></div>
              <div class="relative z-10">
                <div class="text-2xl font-bold text-white">1.8 <span class="text-xs font-normal text-white/60">t CO₂</span></div>
                <div class="text-[10px] text-white/70 mt-0.5">Emisiones evitadas</div>
                <div class="text-[9px] text-[#4F8A5B] mt-1.5 font-bold">↑ 9% mensual</div>
              </div>
            </div>
            
            <!-- Box 4: Valor -->
            <div class="bg-black/60 border border-white/10 rounded-2xl p-4 relative overflow-hidden group hover:border-[#7A1F3D]/50 transition-colors cursor-default">
              <img src="/mod_foto_1785800509198.png" class="absolute inset-0 w-full h-full object-cover opacity-20 group-hover:opacity-40 transition-opacity duration-500" />
              <div class="absolute inset-0 bg-gradient-to-t from-black/80 to-transparent"></div>
              <div class="relative z-10">
                <div class="text-2xl font-bold text-white">S/ 5.6K</div>
                <div class="text-[10px] text-white/70 mt-0.5">Valor circulante local</div>
                <div class="text-[9px] text-[#4F8A5B] mt-1.5 font-bold">↑ 22% mensual</div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- 3. Modules (Infinite Marquee) -->
      <section id="modulos" class="scroll-mt-24 w-full mb-24 overflow-hidden relative">
        <!-- Contenedor transparente para difuminar bordes opcional -->
        <div class="absolute inset-y-0 left-0 w-24 bg-gradient-to-r from-[#101114] to-transparent z-10 pointer-events-none"></div>
        <div class="absolute inset-y-0 right-0 w-24 bg-gradient-to-l from-[#101114] to-transparent z-10 pointer-events-none"></div>
        
        <div class="marquee-content gap-6 pt-2 pb-6">
          <!-- GRUPO 1 -->
          <div data-categoria="Hoteles / Hospedajes" class="btn-categoria glass-bubble w-72 p-4 flex items-center gap-4 hover:-translate-y-1 transition-transform cursor-pointer border border-white/10 rounded-2xl flex-shrink-0">
            <img src="/mod_hotel_1785800485064.png" alt="Hotel" class="w-20 h-20 rounded-xl object-cover shadow-lg" />
            <div class="text-left">
              <h4 class="text-sm font-bold text-white mb-1 leading-tight">Hoteles / Hospedajes</h4>
              <p class="text-[10px] text-white/50 leading-tight">Alojamientos oficiales.</p>
            </div>
          </div>
          <div data-categoria="Restaurantes" class="btn-categoria glass-bubble w-72 p-4 flex items-center gap-4 hover:-translate-y-1 transition-transform cursor-pointer border border-white/10 rounded-2xl flex-shrink-0">
            <img src="/mod_restaurante_1785800492796.png" alt="Restaurante" class="w-20 h-20 rounded-xl object-cover shadow-lg" />
            <div class="text-left">
              <h4 class="text-sm font-bold text-white mb-1 leading-tight">Restaurantes</h4>
              <p class="text-[10px] text-white/50 leading-tight">Gastronomía local.</p>
            </div>
          </div>
          <div data-categoria="Atractivos Turísticos" class="btn-categoria glass-bubble w-72 p-4 flex items-center gap-4 hover:-translate-y-1 transition-transform cursor-pointer border border-white/10 rounded-2xl flex-shrink-0">
            <img src="/mod_atractivo.png" alt="Atractivos" class="w-20 h-20 rounded-xl object-cover shadow-lg" />
            <div class="text-left">
              <h4 class="text-sm font-bold text-white mb-1 leading-tight">Atractivos</h4>
              <p class="text-[10px] text-white/50 leading-tight">Descubre maravillas.</p>
            </div>
          </div>
          <div data-categoria="Guías Turísticos" class="btn-categoria glass-bubble w-72 p-4 flex items-center gap-4 hover:-translate-y-1 transition-transform cursor-pointer border border-white/10 rounded-2xl flex-shrink-0">
            <img src="/mod_guia_1785800500716.png" alt="Guías" class="w-20 h-20 rounded-xl object-cover shadow-lg" />
            <div class="text-left">
              <h4 class="text-sm font-bold text-white mb-1 leading-tight">Guías Turísticos</h4>
              <p class="text-[10px] text-white/50 leading-tight">Rutas seguras.</p>
            </div>
          </div>
          <div data-categoria="Actividades" class="btn-categoria glass-bubble w-72 p-4 flex items-center gap-4 hover:-translate-y-1 transition-transform cursor-pointer border border-white/10 rounded-2xl flex-shrink-0">
            <img src="/mod_actividad.png" alt="Actividades" class="w-20 h-20 rounded-xl object-cover shadow-lg" />
            <div class="text-left">
              <h4 class="text-sm font-bold text-white mb-1 leading-tight">Actividades</h4>
              <p class="text-[10px] text-white/50 leading-tight">Experiencias únicas.</p>
            </div>
          </div>

          <!-- GRUPO 2 (Duplicado exacto para crear el bucle infinito) -->
          <div data-categoria="Hoteles / Hospedajes" class="btn-categoria glass-bubble w-72 p-4 flex items-center gap-4 hover:-translate-y-1 transition-transform cursor-pointer border border-white/10 rounded-2xl flex-shrink-0">
            <img src="/mod_hotel_1785800485064.png" alt="Hotel" class="w-20 h-20 rounded-xl object-cover shadow-lg" />
            <div class="text-left">
              <h4 class="text-sm font-bold text-white mb-1 leading-tight">Hoteles / Hospedajes</h4>
              <p class="text-[10px] text-white/50 leading-tight">Alojamientos oficiales.</p>
            </div>
          </div>
          <div data-categoria="Restaurantes" class="btn-categoria glass-bubble w-72 p-4 flex items-center gap-4 hover:-translate-y-1 transition-transform cursor-pointer border border-white/10 rounded-2xl flex-shrink-0">
            <img src="/mod_restaurante_1785800492796.png" alt="Restaurante" class="w-20 h-20 rounded-xl object-cover shadow-lg" />
            <div class="text-left">
              <h4 class="text-sm font-bold text-white mb-1 leading-tight">Restaurantes</h4>
              <p class="text-[10px] text-white/50 leading-tight">Gastronomía local.</p>
            </div>
          </div>
          <div data-categoria="Atractivos Turísticos" class="btn-categoria glass-bubble w-72 p-4 flex items-center gap-4 hover:-translate-y-1 transition-transform cursor-pointer border border-white/10 rounded-2xl flex-shrink-0">
            <img src="/mod_atractivo.png" alt="Atractivos" class="w-20 h-20 rounded-xl object-cover shadow-lg" />
            <div class="text-left">
              <h4 class="text-sm font-bold text-white mb-1 leading-tight">Atractivos</h4>
              <p class="text-[10px] text-white/50 leading-tight">Descubre maravillas.</p>
            </div>
          </div>
          <div data-categoria="Guías Turísticos" class="btn-categoria glass-bubble w-72 p-4 flex items-center gap-4 hover:-translate-y-1 transition-transform cursor-pointer border border-white/10 rounded-2xl flex-shrink-0">
            <img src="/mod_guia_1785800500716.png" alt="Guías" class="w-20 h-20 rounded-xl object-cover shadow-lg" />
            <div class="text-left">
              <h4 class="text-sm font-bold text-white mb-1 leading-tight">Guías Turísticos</h4>
              <p class="text-[10px] text-white/50 leading-tight">Rutas seguras.</p>
            </div>
          </div>
          <div data-categoria="Actividades" class="btn-categoria glass-bubble w-72 p-4 flex items-center gap-4 hover:-translate-y-1 transition-transform cursor-pointer border border-white/10 rounded-2xl flex-shrink-0">
            <img src="/mod_actividad.png" alt="Actividades" class="w-20 h-20 rounded-xl object-cover shadow-lg" />
            <div class="text-left">
              <h4 class="text-sm font-bold text-white mb-1 leading-tight">Actividades</h4>
              <p class="text-[10px] text-white/50 leading-tight">Experiencias únicas.</p>
            </div>
          </div>
        </div>
      </section>
      </div> <!-- Fin Contenedor de Portada -->

      <!-- 4. Sobre la Plataforma -->
      <section id="que-es" class="scroll-mt-24 max-w-7xl mx-auto px-6 mt-32 md:mt-48 mb-32 grid grid-cols-1 lg:grid-cols-3 gap-12 items-center">
        <div>
          <h2 class="text-3xl font-bold text-white mb-4">Sobre la Plataforma</h2>
          <p class="text-white/70 mb-4 text-sm font-light leading-relaxed">
            Esta plataforma busca ser la infraestructura digital integrada que el ecosistema turístico de Arequipa necesitaba para conectar a visitantes y actores locales.
          </p>
          <div class="bg-[#7A1E2D]/40 border border-[#F1B400]/30 p-4 rounded-xl backdrop-blur-sm mt-4 shadow-lg inline-block">
            <ul class="text-[#F1B400] font-bold text-xs space-y-2">
              <li>• Organiza todo tu viaje desde un solo lugar.</li>
              <li>• Ahorra tiempo al planificar.</li>
              <li>• Encuentra información clara y confiable.</li>
              <li>• Descubre nuevos lugares y negocios locales.</li>
            </ul>
          </div>
        </div>
        
        <div class="flex flex-col items-center justify-center relative py-6">
          <!-- OBJETO 3D FÍSICO (Imagen generada sin el cuadrado blanco) -->
          <div class="w-56 h-56 rounded-[2rem] glass-bubble flex items-center justify-center border border-white/20 relative z-10 shadow-2xl bg-black/40 perspective-[1200px]">
             
             <!-- Contenedor Circular Rotando (Recorta el fondo blanco cuadrado) -->
             <div class="w-48 h-48 rounded-full bg-white overflow-hidden border-[6px] border-[#F1B400] shadow-[0_0_30px_rgba(241,180,0,0.4)] animate-3d-object cursor-pointer flex items-center justify-center relative">
               
               <!-- Cara Frontal (Imagen generada) -->
               <div class="absolute inset-0 w-full h-full backface-hidden flex items-center justify-center bg-white">
                 <img src="/kaypi_new_3d_pin.png" alt="KAYPI Logo 3D Generado" class="w-[110%] h-[110%] max-w-none object-cover" />
               </div>
               
               <!-- Cara Trasera -->
               <div class="absolute inset-0 w-full h-full backface-hidden bg-[#7A1E2D] flex items-center justify-center [transform:rotateY(180deg)]">
                 <img src="/kaypi_new_3d_pin.png" alt="KAYPI Trasero" class="w-[110%] h-[110%] max-w-none object-cover brightness-0 invert opacity-50" />
               </div>

             </div>

          </div>
          <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-64 h-64 bg-[#7A1F3D]/20 rounded-full blur-[40px] -z-10"></div>
        </div>

        <div>
          <h2 class="text-3xl font-bold text-white mb-6">Nuestras Metas</h2>
          <div class="space-y-4">
            <div class="flex gap-4 items-start">
              <div class="w-8 h-8 rounded-full glass-bubble flex-shrink-0 flex items-center justify-center text-white/70 text-xs">📉</div>
              <p class="text-xs text-white/70 leading-relaxed mt-1">Reducir la contaminación turística mediante reutilización y valorización.</p>
            </div>
            <div class="flex gap-4 items-start">
              <div class="w-8 h-8 rounded-full glass-bubble flex-shrink-0 flex items-center justify-center text-white/70 text-xs">🤝</div>
              <p class="text-xs text-white/70 leading-relaxed mt-1">Generar impacto económico local conectando recursos con quienes más los necesitan.</p>
            </div>
            <div class="flex gap-4 items-start">
              <div class="w-8 h-8 rounded-full glass-bubble flex-shrink-0 flex items-center justify-center text-white/70 text-xs">🌱</div>
              <p class="text-xs text-white/70 leading-relaxed mt-1">Promover turismo responsable e involucrar activamente a visitantes y negocios.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- 5. Lugares Potenciales -->
      <section class="max-w-7xl mx-auto px-6 mb-24">
        <div class="flex items-center justify-between mb-8">
          <h2 class="text-3xl font-bold text-white">Lugares Potenciales en <span class="text-[#92284B]">Arequipa</span></h2>
          <div class="hidden md:flex gap-2">
            <div class="w-8 h-8 rounded-full border border-white/20 flex items-center justify-center text-white/50 cursor-pointer hover:bg-white/10">&lt;</div>
            <div class="w-8 h-8 rounded-full border border-white/20 flex items-center justify-center text-white/50 cursor-pointer hover:bg-white/10">&gt;</div>
          </div>
        </div>
        
        <div class="flex overflow-x-auto snap-x snap-mandatory hide-scrollbar gap-4 pb-4">
          <!-- Card Lugar -->
          <div class="snap-start min-w-[260px] glass-bubble rounded-[2rem] overflow-hidden group border border-white/10">
            <!-- RECUADRO IMAGEN -->
            <div class="h-32 bg-white/5 relative overflow-hidden border-b border-white/5">
              <img src="/loc_centro_historico.png" alt="Centro Histórico" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700" />
            </div>
            <div class="p-5">
              <h3 class="text-sm font-bold text-white mb-1">Centro Histórico</h3>
              <p class="text-[10px] text-white/60 leading-relaxed">Hoteles boutique y cafés con alto potencial de recursos.</p>
            </div>
          </div>
          <!-- Card Lugar -->
          <div class="snap-start min-w-[260px] glass-bubble rounded-[2rem] overflow-hidden group border border-white/10">
            <!-- RECUADRO IMAGEN -->
            <div class="h-32 bg-white/5 relative overflow-hidden border-b border-white/5">
              <img src="/loc_cayma.png" alt="Cayma y Yanahuara" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700" />
            </div>
            <div class="p-5">
              <h3 class="text-sm font-bold text-white mb-1">Cayma & Yanahuara</h3>
              <p class="text-[10px] text-white/60 leading-relaxed">Zonas residenciales y comerciales con fuerte actividad.</p>
            </div>
          </div>
          <!-- Card Lugar -->
          <div class="snap-start min-w-[260px] glass-bubble rounded-[2rem] overflow-hidden group border border-white/10">
            <!-- RECUADRO IMAGEN -->

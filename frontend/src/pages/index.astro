                <div>
                  <label class="text-[10px] text-white/50 uppercase font-bold ml-1">RUC / NIT</label>
                  <input id="swal-ruc" class="w-full bg-black/40 border border-white/20 text-white rounded-lg p-3 text-sm focus:border-[#F1B400] outline-none" placeholder="1045...">
                </div>
                <div>
                  <label class="text-[10px] text-white/50 uppercase font-bold ml-1">Rubro Principal</label>
                  <select id="swal-tipo" class="w-full bg-black/40 border border-white/20 text-white rounded-lg p-3 text-sm focus:border-[#F1B400] outline-none">
                    <option value="Hospedaje">Hospedaje (Hotel, Hostal, etc.)</option>
                    <option value="Restaurante">Gastronomía (Restaurante, Café)</option>
                    <option value="Atractivo">Atractivo Turístico / Museo</option>
                    <option value="Guia">Operador Turístico / Guía</option>

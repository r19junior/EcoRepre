          { nombre: "Hotel Casa Andina Premium", img: "/mod_hotel_1785800485064.png", rating: "4.9 (240 reseñas)" },
          { nombre: "El Monasterio Eco-Lodge", img: "/mod_hotel_1785800485064.png", rating: "4.8 (189 reseñas)" },
          { nombre: "Hostal La Recoleta", img: "/mod_hotel_1785800485064.png", rating: "4.7 (95 reseñas)" }
        ],
        "Restaurantes": [
          { nombre: "Chicha por Gastón Acurio", img: "/mod_restaurante_1785800492796.png", rating: "4.9 (420 reseñas)" },
          { nombre: "La Benita de los Claustros", img: "/mod_restaurante_1785800492796.png", rating: "4.8 (310 reseñas)" },
          { nombre: "Zig Zag Restaurant", img: "/mod_restaurante_1785800492796.png", rating: "4.7 (200 reseñas)" }

---
// frontend/src/pages/index.astro
import '../styles/global.css';
---
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>EcoLoop Arequipa</title>
    <style>
      body {
        background: radial-gradient(circle at top, #0f172a 0%, #020617 50%, #000000 100%);
        color: #f8fafc;
        min-height: 100vh;
      }
      .glass-panel {
        background: rgba(255, 255, 255, 0.03);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid rgba(255, 255, 255, 0.05);
      }
      .glow-gold {
        box-shadow: 0 0 25px rgba(212, 175, 55, 0.5);
      }
      .hover-glow-gold:hover {
        box-shadow: 0 0 40px rgba(212, 175, 55, 0.8);
        border-color: #D4AF37;
      }
      .gradient-text-gold {
        background: linear-gradient(to right, #F9D423, #D4AF37, #C5A028);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
      }
    </style>
  </head>
  <body class="font-sans antialiased overflow-x-hidden selection:bg-[#D4AF37] selection:text-[#020617] relative flex flex-col justify-between min-h-screen">
    
    <!-- Dynamic Background Elements -->
    <div class="fixed top-[-10%] left-[-10%] w-[50%] h-[50%] rounded-full bg-indigo-900 mix-blend-screen filter blur-[150px] opacity-30 -z-10 animate-pulse"></div>
    <div class="fixed bottom-[-10%] right-[-10%] w-[40%] h-[40%] rounded-full bg-[#D4AF37] mix-blend-screen filter blur-[150px] opacity-10 -z-10"></div>
    
    <!-- Navbar (Sticky, Dynamic) -->
    <nav class="sticky top-0 z-50 bg-[#020617]/70 backdrop-blur-md border-b border-white/5 transition-all duration-300">
      <div class="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between">
        <div class="flex items-center gap-3 group cursor-pointer">
          <div class="w-10 h-10 rounded-full border border-[#D4AF37]/50 flex items-center justify-center group-hover:glow-gold transition-all duration-500">
            <span class="font-bold text-[#D4AF37] text-sm">ECO</span>
          </div>
          <span class="font-bold tracking-widest text-lg text-slate-200 group-hover:text-white transition-colors">LOOP</span>
        </div>
      </div>
    </nav>

    <!-- Main Hero -->
    <main class="flex-grow flex flex-col items-center justify-center p-6 text-center relative z-10 w-full max-w-7xl mx-auto mt-10 md:mt-0">
      
      <div class="inline-block px-4 py-1.5 rounded-full glass-panel border border-[#D4AF37]/30 text-xs font-semibold uppercase tracking-widest text-[#D4AF37] mb-8 animate-[bounce_3s_infinite]">
        Plataforma Tecnológica B2B / B2C
      </div>

      <h1 class="text-5xl md:text-7xl lg:text-8xl font-extrabold mb-6 tracking-tight leading-tight">
        Conectando el <br class="hidden md:block" />
        <span class="gradient-text-gold">Futuro Sostenible</span>
      </h1>
      
      <p class="text-lg md:text-xl text-slate-400 mb-14 max-w-2xl mx-auto font-light leading-relaxed">
        Impulsamos la economía circular y el turismo responsable en Arequipa a través de tecnología de vanguardia y datos en tiempo real.
      </p>

      <!-- Action Cards (Dynamic Layout) -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 w-full max-w-3xl mx-auto">
        
        <a href="/turista" class="glass-panel group relative overflow-hidden rounded-2xl p-8 flex flex-col items-center justify-center hover:scale-105 transition-all duration-500 hover-glow-gold">
          <div class="absolute inset-0 bg-gradient-to-br from-[#D4AF37]/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
          <div class="w-16 h-16 rounded-full bg-slate-800/50 flex items-center justify-center mb-6 group-hover:bg-[#D4AF37]/20 transition-colors border border-white/5">
            <svg class="w-8 h-8 text-[#D4AF37]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          </div>
          <h2 class="text-2xl font-bold text-white mb-2 group-hover:text-[#D4AF37] transition-colors">Vista Turista</h2>
          <p class="text-sm text-slate-400 text-center">Explora el directorio EcoScore y descubre lugares sostenibles.</p>
          
          <div class="mt-8 flex items-center text-[#D4AF37] text-sm font-semibold tracking-wider">
            INGRESAR AL MODO B2C 
            <svg class="w-4 h-4 ml-2 group-hover:translate-x-2 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
          </div>
        </a>

        <a href="/empresa" class="glass-panel group relative overflow-hidden rounded-2xl p-8 flex flex-col items-center justify-center hover:scale-105 transition-all duration-500 hover-glow-gold">
          <div class="absolute inset-0 bg-gradient-to-br from-[#D4AF37]/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
          <div class="w-16 h-16 rounded-full bg-slate-800/50 flex items-center justify-center mb-6 group-hover:bg-[#D4AF37]/20 transition-colors border border-white/5">
            <svg class="w-8 h-8 text-[#D4AF37]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path></svg>
          </div>
          <h2 class="text-2xl font-bold text-white mb-2 group-hover:text-[#D4AF37] transition-colors">Vista Empresa</h2>
          <p class="text-sm text-slate-400 text-center">Panel B2B para gestión de mermas y monitoreo de métricas.</p>
          
          <div class="mt-8 flex items-center text-[#D4AF37] text-sm font-semibold tracking-wider">
            INGRESAR AL MODO B2B 
            <svg class="w-4 h-4 ml-2 group-hover:translate-x-2 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
          </div>
        </a>

      </div>
    </main>
    
    <footer class="py-6 text-center border-t border-white/5 bg-[#020617]/50 backdrop-blur-md">
      <p class="text-xs text-slate-500 tracking-wider">© 2026 ECOLOOP AREQUIPA. DISEÑADO PARA EL FUTURO.</p>
    </footer>
  </body>
</html>
